# Copy this file to .env and fill in your key
GOOGLE_API_KEY=your-gemini-api-key-here

# Optional overrides
GEMINI_CHAT_MODEL=gemini-2.5-flash
# Free-tier quotas are per model; on 429 errors the agent fails over in order.
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-3-flash-preview,gemini-3.5-flash
GEMINI_STT_MODEL=gemini-2.5-flash-lite
EMBEDDING_MODEL=models/gemini-embedding-001

# Local fallback STT (faster-whisper). Options: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=base

# Which STT engine to prefer: gemini | whisper
STT_PRIMARY=gemini
